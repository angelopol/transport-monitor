# AWS Credentials for Transport Monitor
# Copy this file to .env and fill in your values

# AWS Access Key ID (required for Rekognition)
AWS_ACCESS_KEY_ID=your_access_key_id_here

# AWS Secret Access Key (required for Rekognition)
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Region (optional, defaults to us-east-1)
AWS_REGION=us-east-1

# AWS Session Token (optional, only for temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Camera Configuration (optional, can also be set in config.yaml)
# CAMERA_SOURCE=0

# Dry run mode - set to true to skip AWS calls
# DRY_RUN=false

# ========================================
# GEOLOCATION SETTINGS
# ========================================

# Enable GPS/location tracking for passenger events (true/false)
# When enabled, records GPS coordinates with each passenger boarding
ENABLE_LOCATION_TRACKING=true

# GPS Serial Port (optional, for Windows USB GPS devices)
# Windows: COM3, COM4, etc.
# Linux: /dev/ttyUSB0, /dev/ttyACM0, etc.
# GPS_SERIAL_PORT=COM3

# Use IP geolocation as fallback when GPS unavailable (true/false)
# Less accurate (~city level) but works without GPS hardware
ENABLE_IP_FALLBACK=true

# ========================================
# TIMEZONE SETTINGS
# ========================================

# UTC offset in whole hours for local timestamps stored in SQLite.
# Venezuela Standard Time (VET) = UTC-4, no daylight saving.
# Change for other deployments: -5 (EST/COT), -6 (CST), etc.
TZ_OFFSET_HOURS=-4

# ========================================
# FACE DETECTION THRESHOLDS
# ========================================

# Minimum face size in pixels (width AND height must exceed this).
# Smaller values detect distant/small faces but increase false positives.
# Range: 20–200 px  |  Default: 50
FACE_MIN_SIZE=50

# Minimum sharpness score for a face to be counted (0–100).
# Faces below this are too blurry for reliable identification.
# Higher = stricter blur rejection.  |  Default: 80
FACE_BLUR_THRESHOLD=80

# Minimum Rekognition/MediaPipe confidence that the detection is a face (0–100).
# Default: 90
FACE_CONFIDENCE_THRESHOLD=90

# Maximum allowed occlusion level (0–100). Faces more occluded than this are skipped.
# Default: 80
FACE_OCCLUDED_THRESHOLD=80

# Minimum frontal-pose score (0–100). Low values mean the face is turned too far sideways.
# Default: 35
FACE_FRONTAL_THRESHOLD=35

# ========================================
# PASSENGER TRACKING
# ========================================

# Enable face-based passenger deduplication (true/false).
# When false, every detected face is counted as a new passenger.
TRACKING_ENABLED=true

# Minutes to remember a passenger before treating them as new again.
# Set to match a typical trip duration.  |  Default: 180 (3 hours)
TRACKING_TTL_MINUTES=180

# Minimum similarity percentage (0–100) to match a face to a known passenger.
# Higher = stricter matching, fewer false duplicates.  |  Default: 80
TRACKING_SIMILARITY_THRESHOLD=80

# Maximum number of passengers kept in the tracker at once.
# Default: 500
TRACKING_MAX_FACES=500

# ========================================
# MOTION DETECTION
# ========================================

# Minimum changed-pixel area (px²) to trigger face detection.
# Lower = more sensitive, higher = ignores small movements.  |  Default: 15000
MOTION_MIN_AREA=15000

# Pixel difference sensitivity (0–255). Lower = detects subtler motion.  |  Default: 50
MOTION_THRESHOLD=50

# Gaussian blur kernel size for motion background subtraction (must be odd).  |  Default: 21
MOTION_BLUR_KERNEL=21

# Frames to stay in "motion active" state after the last movement detected.  |  Default: 5
MOTION_COOLDOWN_FRAMES=5

# ========================================
# CLOUD SYNC SETTINGS
# ========================================

# Enable syncing of events to the cloud backend (true/false)
SYNC_ENABLED=true

# API URL for the backend server
# Default for local development: http://localhost:8000/api/v1
SYNC_API_URL=http://localhost:8000/api/v1

# API Token for authentication with the backend
# Must match a valid token generated on the server
SYNC_API_TOKEN=your_token_here

# Unique Identifier for this device (MAC address format)
DEVICE_MAC=00:00:00:00:00:01
